@page
@model WtLab5Banking.Razor.Pages.Accounts.EditModel
@{
    ViewData["Title"] = "Изменить счёт";
}

<div class="page-header">
    <h1>Изменить счёт #@Model.Id</h1>
</div>

<div class="card form-card-bootstrap shadow-sm rounded">
    <div class="card-body p-4">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="validation mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.AccountNumber" class="form-label"></label>
                <input asp-for="Input.AccountNumber" class="form-control" />
                <span asp-validation-for="Input.AccountNumber" class="validation"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.OwnerName" class="form-label"></label>
                <input asp-for="Input.OwnerName" class="form-control" />
                <span asp-validation-for="Input.OwnerName" class="validation"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-5">
                    <label asp-for="Input.Currency" class="form-label"></label>
                    <input asp-for="Input.Currency" class="form-control" />
                    <span asp-validation-for="Input.Currency" class="validation"></span>
                </div>
                <div class="col-12 col-sm-7">
                    <label asp-for="Input.Balance" class="form-label"></label>
                    <input asp-for="Input.Balance" class="form-control" />
                    <span asp-validation-for="Input.Balance" class="validation"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Nickname" class="form-label"></label>
                <input asp-for="Input.Nickname" class="form-control" />
                <span asp-validation-for="Input.Nickname" class="validation"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-dark">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Id">Отмена</a>
            </div>
        </form>
    </div>
</div>
